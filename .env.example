# Supabase — https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Zoho SMTP — used when Supabase Auth email is rate-limited
ZOHO_MAIL_USER=
ZOHO_MAIL_FROM=
ZOHO_MAIL_APP_PASSWORD=
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465

# Groq Whisper — https://console.groq.com/keys
GROQ_API_KEY=

# NVIDIA Nemotron — https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional — higher GitHub rate limits
GITHUB_TOKEN=

# Set to false to turn login back on
NEXT_PUBLIC_AUTH_BYPASS=true

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron secret for expiry job
CRON_SECRET=

# Local Instagram audio (not used on Vercel)
YTDLP_COOKIES_FROM_BROWSER=chrome

# Captapi — Instagram URL to transcript
CAPTAPI_API_KEY=
